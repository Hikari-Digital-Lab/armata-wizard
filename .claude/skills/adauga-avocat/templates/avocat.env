# Lawyer worker .env — GATED, own topic only. chmod 600 after writing.
# Replace placeholders at install:
#   <GEMINI_KEY>  reuse the key from an existing team profile's .env (NEVER invent)
#   <TOKEN>       the NEW bot token from BotFather (collected via AskUserQuestion → Other)
#   <GROUP_ID>    e.g. -1004297076441  (TELEGRAM_GROUP_ALLOWED_CHATS of the team)
#   <TOPIC_ID>    the new "<TOPIC_NAME>" topic id (created via API or from getUpdates)
#   <TOPIC_NAME>  e.g. Juridic

GOOGLE_API_KEY=<GEMINI_KEY>
GEMINI_API_KEY=<GEMINI_KEY>
TELEGRAM_BOT_TOKEN=<TOKEN>
TELEGRAM_GROUP_ALLOWED_CHATS=<GROUP_ID>
TELEGRAM_REQUIRE_MENTION=true
TELEGRAM_EXCLUSIVE_BOT_MENTIONS=true
TELEGRAM_ALLOWED_TOPICS=<TOPIC_ID>

# Anti-chatter: quiet home channel = the lawyer's OWN topic, so any proactive/cron
# delivery stays in-topic and the "📬 No home channel" notice never fires.
TELEGRAM_HOME_CHANNEL=<GROUP_ID>
TELEGRAM_HOME_CHANNEL_NAME=<TOPIC_NAME>
TELEGRAM_CRON_THREAD_ID=<TOPIC_ID>

# NOTE: web search for the lawyer is enabled in config.yaml (web.search_backend: ddgs),
# NOT here. The `ddgs` package must be installed in the Hermes venv (the skill does this).
