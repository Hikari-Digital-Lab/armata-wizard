# CEO (manager) .env — the ONE FREE bot. chmod 600 after writing.
# Replace placeholders at install:
#   <GEMINI_KEY>  your Google AI Studio / Gemini key (collected via AskUserQuestion → Other)
#   <TOKEN>       the CEO bot token from BotFather
#   <GROUP_ID>    the new group id, e.g. -1004297076441 (from getUpdates)

GOOGLE_API_KEY=<GEMINI_KEY>
GEMINI_API_KEY=<GEMINI_KEY>
TELEGRAM_BOT_TOKEN=<TOKEN>

# --- The CEO is the ONLY free bot -------------------------------------------------
TELEGRAM_GROUP_ALLOWED_CHATS=<GROUP_ID>
TELEGRAM_REQUIRE_MENTION=false
TELEGRAM_EXCLUSIVE_BOT_MENTIONS=true
# Explicit topic allowlist, starting with General (id 1). Worker skills (adauga-artist /
# adauga-copywriter) APPEND their topic id here (e.g. 1,2,289). Keep this an explicit list so
# those skills stay compatible.
TELEGRAM_ALLOWED_TOPICS=1

# --- Direct messages (DM) ---------------------------------------------------------
# DMs are open by default: TELEGRAM_ALLOWED_USERS is left UNSET, so the CEO answers private
# chats too. To lock down later, set TELEGRAM_ALLOWED_USERS=<your_user_id,...>.
# TELEGRAM_ALLOWED_USERS=

# --- Anti-chatter: quiet home channel = General -----------------------------------
# Prevents the "📬 No home channel" notice on a brand-new bot; keeps any cron/proactive in General.
TELEGRAM_HOME_CHANNEL=<GROUP_ID>
TELEGRAM_HOME_CHANNEL_NAME=General
# (General is topic id 1; no TELEGRAM_CRON_THREAD_ID needed for the General topic.)
