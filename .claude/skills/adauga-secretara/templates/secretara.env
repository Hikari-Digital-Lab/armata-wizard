# Secretary worker .env — GATED, own topic only. chmod 600 after writing.
# Replace placeholders at install:
#   <GEMINI_KEY>     reuse the key from an existing team profile's .env (NEVER invent)
#   <TOKEN>          the NEW secretary bot token from BotFather (AskUserQuestion → Other)
#   <GROUP_ID>       e.g. -1004297076441  (TELEGRAM_GROUP_ALLOWED_CHATS of the team)
#   <TOPIC_ID>       the new "<TOPIC_NAME>" topic id (created via API or from getUpdates)
#   <TOPIC_NAME>     e.g. Secretariat
#   <CEO_TOKEN>      the CEO's bot token (used by the inbox watcher to wake ONLY the secretary)
#   <SECRETARY_USERNAME>  bare bot username, no @ (e.g. erin_hannon_office_bot)
#   <MAILBOX_ADDRESS>     the Gmail/Yahoo address
#   <MAILBOX_APP_PASSWORD>  the 16-char App Password (NOT the normal account password)

GOOGLE_API_KEY=<GEMINI_KEY>
GEMINI_API_KEY=<GEMINI_KEY>

# --- Telegram identity (gated worker, own topic) ---
TELEGRAM_BOT_TOKEN=<TOKEN>
TELEGRAM_GROUP_ALLOWED_CHATS=<GROUP_ID>
TELEGRAM_REQUIRE_MENTION=true
TELEGRAM_EXCLUSIVE_BOT_MENTIONS=true
TELEGRAM_ALLOWED_TOPICS=<TOPIC_ID>

# --- Anti-chatter: home channel = the secretary's OWN topic (suppresses "📬 No home channel") ---
TELEGRAM_HOME_CHANNEL=<GROUP_ID>
TELEGRAM_HOME_CHANNEL_NAME=<TOPIC_NAME>
TELEGRAM_CRON_THREAD_ID=<TOPIC_ID>

# --- Inbox watcher wake-up: it posts the raw mail to the secretary via the CEO's token, with an
#     EXCLUSIVE @secretary mention => only the secretary wakes, the free CEO ignores the raw dump. ---
TELEGRAM_NOTIFY_TOKEN=<CEO_TOKEN>
SECRETARY_MENTION=@<SECRETARY_USERNAME>
SECRETARIAT_THREAD_ID=<TOPIC_ID>

# --- Mailbox (send via SMTP, receive via IMAP). NOTE: vars are MAILBOX_* (NOT EMAIL_*) ON PURPOSE.
#     EMAIL_ADDRESS/EMAIL_PASSWORD would make Hermes auto-start its NATIVE email gateway and fight
#     these scripts for the inbox. MAILBOX_* keeps the native channel OFF -> deterministic scripts own it.
#     App Password (NOT the normal password):
#        Gmail:  https://myaccount.google.com/apppasswords   (needs 2-Step Verification ON)
#        Yahoo:  https://login.yahoo.com/account/security/app-passwords  (External connections → Create app password)
MAILBOX_ADDRESS=<MAILBOX_ADDRESS>
MAILBOX_PASSWORD=<MAILBOX_APP_PASSWORD>
# Hosts — set the pair for the chosen provider:
#   Gmail:  MAILBOX_IMAP_HOST=imap.gmail.com       MAILBOX_SMTP_HOST=smtp.gmail.com
#   Yahoo:  MAILBOX_IMAP_HOST=imap.mail.yahoo.com  MAILBOX_SMTP_HOST=smtp.mail.yahoo.com
MAILBOX_IMAP_HOST=<MAILBOX_IMAP_HOST>
MAILBOX_IMAP_PORT=993
MAILBOX_SMTP_HOST=<MAILBOX_SMTP_HOST>
MAILBOX_SMTP_PORT=465
MAILBOX_POLL_INTERVAL=120
